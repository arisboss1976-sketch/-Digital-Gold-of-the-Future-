#### ✅ **Database Pooling (รองรับ 24 Nodes พร้อมกัน)**
```php
// core/database-pool.php
<?php
class DatabasePool {
    private static $instance = null;
    private $connections = [];
    private $maxConnections = 10;
    private $currentConnections = 0;
    
    public static function getInstance() {
        if (!self::$instance) {
            self::$instance = new self();
        }
        return self::$instance;
    }
    
    public function getConnection() {
        // ลองใช้ Connection ที่ว่างก่อน
        foreach ($this->connections as $key => $conn) {
            if ($conn['in_use'] === false) {
                $this->connections[$key]['in_use'] = true;
                return $conn['pdo'];
            }
        }
        
        // สร้าง Connection ใหม่ถ้ายังไม่เกิน Limit
        if ($this->currentConnections < $this->maxConnections) {
            return $this->createNewConnection();
        }
        
        // รอ Connection ว่าง (Queue System)
        return $this->waitForConnection();
    }
    
    private function createNewConnection() {
        $pdo = new PDO(
            'mysql:host=' . getenv('DB_HOST') . ';dbname=' . getenv('DB_NAME') . ';charset=utf8mb4',
            getenv('DB_USER'),
            getenv('DB_PASS'),
            [
                PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
                PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
                PDO::ATTR_EMULATE_PREPARES => false,
                PDO::MYSQL_ATTR_USE_BUFFERED_QUERY => true,
                PDO::ATTR_TIMEOUT => 5
            ]
        );
        
        $this->connections[] = [
            'pdo' => $pdo,
            'in_use' => true,
            'created_at' => time()
        ];
        
        $this->currentConnections++;
        return $pdo;
    }
    
    public function releaseConnection($pdo) {
        foreach ($this->connections as $key => $conn) {
            if ($conn['pdo'] === $pdo) {
                $this->connections[$key]['in_use'] = false;
                return true;
            }
        }
        return false;
    }
}
