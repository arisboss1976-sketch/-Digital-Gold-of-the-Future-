#### ✅ **Transaction Logs (ทุกการเคลื่อนไหวของ Dust Vault)**
```php
// logs/transaction-logger.php
<?php
class TransactionLogger {
    private $db;
    
    public function __construct() {
        $this->db = DatabasePool::getInstance()->getConnection();
    }
    
    public function logDustVaultMovement($userId, $stationId, $amount, $type) {
        $stmt = $this->db->prepare("
            INSERT INTO dust_vault_logs 
            (user_id, station_id, amount, transaction_type, ip_address, user_agent, session_id, created_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, NOW())
        ");
        
        $stmt->execute([
            $userId,
            $stationId,
            $amount,
            $type, // 'deposit', 'withdraw', 'transfer'
            $_SERVER['REMOTE_ADDR'] ?? 'unknown',
            $_SERVER['HTTP_USER_AGENT'] ?? 'unknown',
            session_id()
        ]);
        
        // ถ้าเป็นยอดใหญ่ (> 100,000 GDC) ส่ง Alert ทันที
        if (abs($amount) > 100000) {
            $this->sendLargeTransactionAlert($userId, $amount, $type);
        }
    }
    
    public function logLoginAttempt($username, $status, $reason = null) {
        $stmt = $this->db->prepare("
            INSERT INTO login_attempts 
            (username, status, ip_address, user_agent, reason, attempted_at)
            VALUES (?, ?, ?, ?, ?, NOW())
        ");
        
        $stmt->execute([
            $username,
            $status, // 'success', 'failed'
            $_SERVER['REMOTE_ADDR'] ?? 'unknown',
            $_SERVER['HTTP_USER_AGENT'] ?? 'unknown',
            $reason
        ]);
        
        // ถ้าลองผิดเกิน 5 ครั้ง ส่ง Email Alert
        $failedAttempts = $this->countFailedAttempts($username);
        if ($failedAttempts >= 5) {
            $this->sendBruteForceAlert($username, $failedAttempts);
        }
    }
    
    private function countFailedAttempts($username) {
        $stmt = $this->db->prepare("
            SELECT COUNT(*) FROM login_attempts 
            WHERE username = ? AND status = 'failed' 
            AND attempted_at > DATE_SUB(NOW(), INTERVAL 15 MINUTE)
        ");
        $stmt->execute([$username]);
        return $stmt->fetchColumn();
    }
    
    private function sendLargeTransactionAlert($userId, $amount, $type) {
        $alert = new AlertSystem();
        $alert->sendAlert(
            "💰 Large Transaction Alert!\n" .
            "User: {$userId}\n" .
            "Amount: " . number_format($amount) . " GDC\n" .
            "Type: {$type}\n" .
            "IP: {$_SERVER['REMOTE_ADDR']}\n" .
            "Time: " . date('Y-m-d H:i:s'),
            'warning'
        );
    }
    
    private function sendBruteForceAlert($username, $attempts) {
        $alert = new AlertSystem();
        $alert->sendAlert(
            "🔴 Brute Force Alert!\n" .
            "Username: {$username}\n" .
            "Failed Attempts: {$attempts}\n" .
            "IP: {$_SERVER['REMOTE_ADDR']}\n" .
            "Time: " . date('Y-m-d H:i:s'),
            'critical'
        );
        
        // ส่ง Email ไปยัง Admin
        $to = 'EthiHoldings.T@gmail.com';
        $subject = "🔴 URGENT: Brute Force Attack Detected!";
        $message = "Failed login attempts exceeded threshold for username: {$username}";
        mail($to, $subject, $message);
    }
}
